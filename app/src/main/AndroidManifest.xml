<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather API call + connectivity check -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Next upcoming calendar event (runtime permission, rationale shown before request) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Device location for weather when no manual location is set (runtime permission) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Enumerate installed launchable apps WITHOUT the restricted QUERY_ALL_PACKAGES
        permission. On API 30+ package visibility is filtered; declaring the MAIN/LAUNCHER
        intent here lets PackageManager return every launchable activity.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".EinkLauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EinkLauncher"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.EinkLauncher"
            android:windowSoftInputMode="adjustResize">

            <!-- Standard app-launch entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- HOME entry point: makes this installable as a default launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            NotificationListenerService. Enabling it is a special access granted from
            system settings (Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS), never a
            runtime permission dialog. BIND_NOTIFICATION_LISTENER_SERVICE must be held
            by the system to bind to us.
        -->
        <service
            android:name=".notifications.LauncherNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
